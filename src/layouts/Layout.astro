---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import displayFont from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import monoFont from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url';
import siteData from '../data/siteData.json';
import { SITE_CONFIG, EXTERNAL_LINKS } from '../config/constants';

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  /** Sheet shown in the navbar on pages without scroll-spied sections. */
  sheet?: { number: string; label: string };
  /** Keep the page out of search results and skip canonical/og:url (e.g. the 404 page). */
  noindex?: boolean;
}

const { title, description = SITE_CONFIG.defaultDescription, image, imageAlt, sheet, noindex = false } = Astro.props;
const fullTitle = title.includes('|') ? title : `${title} | ${siteData.name}`;
const currentUrl = new URL(Astro.url.pathname, SITE_CONFIG.url).href;
const ogImage = image ? new URL(image, SITE_CONFIG.url).href : `${SITE_CONFIG.url}/og-image.png`;
const ogImageAlt = imageAlt || `${siteData.name} - ${siteData.role}`;
const xSocial = siteData.socials.find(s => s.name === 'X');
const twitterHandle = xSocial ? xSocial.url.replace(/https?:\/\/(www\.)?(x\.com|twitter\.com)\//, '@').replace(/\/$/, '') : '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content={siteData.name} />
    <meta name="theme-color" content={SITE_CONFIG.themeColor} />
    <meta name="keywords" content={`${siteData.name}, ${siteData.role}, portfolio, software engineer, developer, ${siteData.skills.forte.map(s => s.name).join(', ')}`} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />

    <title>{fullTitle}</title>

    <!-- Theme is applied before first paint to avoid a light/dark flash. -->
    <script is:inline>
      try {
        if (localStorage.theme === 'dark' || (!('theme' in localStorage) && matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      } catch {}
      document.documentElement.classList.add('js');
    </script>

    <!-- The display face draws the hero name (the LCP element), so fetch it with the HTML. -->
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <!-- Mono 500 sets every label strip; preloading it stops a small shift when it swaps in. -->
    <link rel="preload" href={monoFont} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:url" content={currentUrl} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content={siteData.name} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={twitterHandle} />
    <meta name="twitter:creator" content={twitterHandle} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {!noindex && <link rel="canonical" href={currentUrl} />}
    <!-- favicon.svg is skipped: it wraps a 142 KB embedded PNG. The 9 KB PNG looks identical. -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="dns-prefetch" href={EXTERNAL_LINKS.api.web3forms} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": siteData.name,
      "jobTitle": siteData.role,
      "email": siteData.email,
      "telephone": siteData.phone,
      "url": SITE_CONFIG.url,
      "image": ogImage,
      "sameAs": siteData.socials.map(s => s.url),
      "address": {
        "@type": "PostalAddress",
        "addressLocality": siteData.location.split(',')[0]?.trim() || siteData.location,
        "addressCountry": siteData.location.split(',')[1]?.trim() || ""
      },
      "knowsAbout": siteData.skills.forte.map(s => s.name).concat(siteData.skills.exposure),
      "description": description
    })} />
  </head>

  <body class="antialiased">
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>
    <Navbar current={sheet} />

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <script>
      // Scroll progress: one transform write per animation frame, passive listener.
      const bar = document.querySelector<HTMLElement>('[data-scroll-progress]');
      if (bar) {
        let queued = false;
        const update = () => {
          queued = false;
          const max = document.documentElement.scrollHeight - innerHeight;
          bar.style.transform = `scaleX(${max > 0 ? scrollY / max : 0})`;
        };
        addEventListener('scroll', () => {
          if (!queued) {
            queued = true;
            requestAnimationFrame(update);
          }
        }, { passive: true });
        update();
      }

      // Reveal-on-scroll. Content is visible by default; it is only hidden once
      // this observer exists, so a script failure never leaves the page blank.
      const targets = document.querySelectorAll('[data-reveal]');
      if (targets.length && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            }
          }
        }, { rootMargin: '0px 0px -8% 0px' });
        // Anything already on screen is marked visible before hiding the rest, so nothing flickers.
        targets.forEach((el) => {
          if (el.getBoundingClientRect().top < innerHeight) el.classList.add('is-in');
          else io.observe(el);
        });
        document.documentElement.classList.add('js-reveal');
      }
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100;
    padding: 0.6rem 1rem;
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-weight: 700;
    transform: translateY(-200%);
  }
  .skip-link:focus {
    transform: none;
  }

  .scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    height: 3px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    pointer-events: none;
  }
</style>
