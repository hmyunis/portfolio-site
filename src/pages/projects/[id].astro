---
import { getImage } from 'astro:assets';
import { ArrowLeft, ArrowRight, ArrowUpRight, Github } from 'lucide-react';
import Layout from '../../layouts/Layout.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import projects from '../../data/projects';
import { sheetNumber } from '../../config/constants';
import type { Project } from '../../types';

export function getStaticPaths() {
  return projects.map((project, index) => ({
    params: { id: project.id },
    props: {
      project,
      index,
      next: projects[(index + 1) % projects.length],
    },
  }));
}

interface Props {
  project: Project;
  index: number;
  next: Project;
}

const { project, index, next } = Astro.props;
const fig = `${sheetNumber('projects')}.${String(index + 1).padStart(2, '0')}`;
const description = project.description || `Case study for ${project.title} - ${project.tagline}`;

// Social previews need a single static image; JPEG is the safest format for link unfurlers.
const ogImage =
  typeof project.thumbnail === 'string'
    ? project.thumbnail
    : (await getImage({ src: project.thumbnail, width: 1200, format: 'jpg', quality: 80 })).src;

// Poster frame for the demo video: shown instantly while the video streams in.
const poster =
  typeof project.thumbnail === 'string'
    ? project.thumbnail
    : (await getImage({ src: project.thumbnail, width: 1280, format: 'webp', quality: 78 })).src;

const demo = project.demoVideo ?? project.demoGif;
const isVideo = Boolean(project.demoVideo);
---

<Layout
  title={`${project.title} | Case Study`}
  description={description}
  image={ogImage}
  imageAlt={`${project.title} - ${project.tagline}`}
  sheet={{ number: fig, label: project.title }}
>
  <article class="frame cs">
    <div class="sheet-box">
      <div class="cs-strip">
        <a href="/#projects" class="cs-back">
          <ArrowLeft size={14} aria-hidden="true" /> All work
        </a>
        <span>Fig. {fig} / {String(projects.length).padStart(2, '0')}</span>
      </div>

      <header class="cs-head">
        <h1 class="cs-title">{project.title}<span class="cs-stop" aria-hidden="true"></span></h1>
        <div class="cs-intro">
          <p class="cs-tagline">{project.tagline}</p>
          <div class="cs-actions">
            {project.links.live && (
              <a class="btn btn--primary" href={project.links.live} target="_blank" rel="noopener noreferrer">
                Visit live <ArrowUpRight size={16} aria-hidden="true" />
              </a>
            )}
            {project.links.repo && (
              <a class="btn" href={project.links.repo} target="_blank" rel="noopener noreferrer">
                <Github size={16} aria-hidden="true" /> Source code
              </a>
            )}
          </div>
        </div>
      </header>

      <figure class="cs-media media-ph">
        {demo && isVideo ? (
          <video
            class="cs-video"
            src={demo}
            poster={poster}
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label={`${project.title} demo recording`}
            data-cs-video
          ></video>
        ) : demo ? (
          <img class="cs-video" src={demo} alt={`${project.title} demo`} decoding="async" />
        ) : (
          <ResponsiveImage
            src={project.thumbnail}
            alt={`${project.title} screenshot`}
            widths={[640, 1000, 1280]}
            sizes="(min-width: 1400px) 1300px, 100vw"
            loading="eager"
            fetchpriority="high"
            class="cs-video"
          />
        )}
        <figcaption class="cs-fig">Fig. {fig} — {project.title}{isVideo ? ', live recording' : ''}</figcaption>
      </figure>

      <div class="cs-body">
        <section class="cs-main" aria-labelledby="cs-overview">
          <p class="mono-label" id="cs-overview">Overview</p>
          <p class="cs-desc">{project.description}</p>

          <p class="mono-label cs-features-label">Features &amp; architecture</p>
          <ol class="cs-features">
            {project.fullDescription.map((point, i) => (
              <li>
                <span class="cs-feature-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span>{point}</span>
              </li>
            ))}
          </ol>
        </section>

        <aside class="cs-side" aria-label="Project details">
          <dl class="cs-spec">
            <div>
              <dt class="mono-label">Stack</dt>
              <dd>
                <ul class="cs-tags">
                  {project.tags.map((tag) => <li>{tag}</li>)}
                </ul>
              </dd>
            </div>
            <div>
              <dt class="mono-label">Live</dt>
              <dd>
                {project.links.live ? (
                  <a href={project.links.live} target="_blank" rel="noopener noreferrer">
                    {new URL(project.links.live).hostname} <ArrowUpRight size={13} aria-hidden="true" />
                  </a>
                ) : (
                  'Not public'
                )}
              </dd>
            </div>
            <div>
              <dt class="mono-label">Source</dt>
              <dd>
                {project.links.repo ? (
                  <a href={project.links.repo} target="_blank" rel="noopener noreferrer">
                    {new URL(project.links.repo).pathname.slice(1)} <ArrowUpRight size={13} aria-hidden="true" />
                  </a>
                ) : (
                  'Private'
                )}
              </dd>
            </div>
          </dl>
        </aside>
      </div>

      <a class="cs-next" href={`/projects/${next.id}`}>
        <span class="mono-label">Next work</span>
        <span class="cs-next-title">
          {next.title} <ArrowRight size={28} aria-hidden="true" />
        </span>
      </a>
    </div>
  </article>
</Layout>

<script>
  // Pause the demo while it is off screen, and respect reduced-motion preferences.
  const video = document.querySelector<HTMLVideoElement>('[data-cs-video]');
  if (video) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      video.removeAttribute('autoplay');
      video.pause();
      video.controls = true;
    } else {
      new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) video.play().catch(() => {});
        else video.pause();
      }).observe(video);
    }
  }
</script>

<style>
  .cs {
    padding-top: 1.25rem;
  }

  .cs-strip {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem var(--pad);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-muted);
    font: 500 11px/1.4 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .cs-back {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-text);
  }
  .cs-back:hover {
    color: var(--color-accent);
  }

  .cs-head {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    align-items: end;
    gap: 1.5rem 3rem;
    padding: clamp(2rem, 5vw, 3.5rem) var(--pad) clamp(1.5rem, 3vw, 2.25rem);
  }
  .cs-title {
    margin: 0;
    overflow-wrap: anywhere;
    font-size: clamp(2.8rem, 8vw, 7.5rem);
    font-stretch: 72%;
    font-weight: 900;
    letter-spacing: -0.01em;
    line-height: 0.85;
    text-transform: uppercase;
  }
  .cs-stop {
    display: inline-block;
    width: 0.17em;
    height: 0.17em;
    margin-left: 0.04em;
    background: var(--color-accent);
  }
  .cs-tagline {
    margin: 0 0 1.25rem;
    font-size: clamp(1.1rem, 1.6vw, 1.35rem);
    font-stretch: 90%;
    font-weight: 600;
    line-height: 1.3;
  }
  .cs-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  .cs-media {
    position: relative;
    margin: 0;
    border-block: 1px solid var(--color-border);
  }
  .cs-media :global(.cs-video) {
    display: block;
    width: 100%;
    height: auto;
    max-height: 78vh;
    object-fit: contain;
  }
  .cs-fig {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 5px 8px;
    background: var(--color-text);
    color: var(--color-bg);
    font: 500 10.5px/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cs-body {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(16rem, 1fr);
  }
  .cs-main {
    padding: 1.75rem var(--pad) 2rem;
    border-right: 1px solid var(--color-border);
  }
  .cs-desc {
    max-width: 62ch;
    margin: 0.75rem 0 0;
    font-size: clamp(1.1rem, 1.5vw, 1.3rem);
    font-stretch: 92%;
    font-weight: 600;
    line-height: 1.45;
  }
  .cs-features-label {
    margin: 2rem 0 0.5rem;
  }
  .cs-features {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cs-features li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    max-width: 75ch;
    padding: 0.85rem 0;
    color: var(--color-muted);
  }
  .cs-features li + li {
    border-top: 1px solid var(--hair);
  }
  .cs-feature-num {
    padding-top: 0.3rem;
    color: var(--color-accent);
    font: 500 11px/1 var(--font-mono);
  }

  .cs-side {
    padding: 1.75rem var(--pad) 2rem;
  }
  .cs-spec {
    position: sticky;
    top: calc(var(--nav-h) + 1.5rem);
    display: grid;
    gap: 1.5rem;
    margin: 0;
  }
  .cs-spec dd {
    margin: 0.6rem 0 0;
    font: 500 13px/1.5 var(--font-mono);
    overflow-wrap: anywhere;
  }
  .cs-spec a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .cs-spec a:hover {
    color: var(--color-accent);
  }
  .cs-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cs-tags li {
    padding: 4px 8px;
    border: 1px solid var(--color-border);
  }

  .cs-next {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem var(--pad) 1.75rem;
    border-top: 2px solid var(--color-border);
    background: var(--color-text);
    color: var(--color-bg);
    transition: background-color 0.2s;
  }
  .cs-next .mono-label {
    color: inherit;
    opacity: 0.7;
  }
  .cs-next-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: clamp(1.8rem, 4.5vw, 3.5rem);
    font-stretch: 72%;
    font-weight: 900;
    line-height: 0.95;
    text-transform: uppercase;
  }
  .cs-next-title :global(svg) {
    flex-shrink: 0;
    transition: transform 0.25s var(--ease-out);
  }
  .cs-next:hover {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }
  .cs-next:hover .cs-next-title :global(svg) {
    transform: translateX(8px);
  }

  @media (max-width: 899px) {
    .cs-head,
    .cs-body {
      grid-template-columns: minmax(0, 1fr);
    }
    .cs-main {
      border-right: 0;
      border-bottom: 1px solid var(--color-border);
    }
    .cs-spec {
      position: static;
      grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    }
  }
</style>
