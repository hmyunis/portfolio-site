---
import Layout from '../layouts/Layout.astro';
import { Home } from 'lucide-react';
import BackButton from '../components/features/404BackButton';
---

<Layout title="404 - Page Not Found">
	<main class="max-w-4xl mx-auto px-6 py-32">
		<div class="text-center space-y-8">
			<div class="space-y-4">
				<h1 class="text-8xl md:text-9xl font-bold text-accent">404</h1>
				<h2 class="text-3xl md:text-4xl font-bold">Page Not Found</h2>
				<p class="text-muted text-lg max-w-md mx-auto">
					The page you're looking for doesn't exist or has been moved.
				</p>
			</div>

			<div class="flex flex-wrap justify-center gap-4 pt-8">
				<a
					href="/"
					class="flex items-center gap-2 px-6 py-3 bg-accent text-white border-[2px] border-border font-semibold hover:opacity-90 transition-all shadow-[6px_6px_0px_0px_rgba(0,0,0,0.15)] dark:shadow-[6px_6px_0px_0px_rgba(255,255,255,0.1)] hover:shadow-[8px_8px_0px_0px_rgba(0,0,0,0.2)] dark:hover:shadow-[8px_8px_0px_0px_rgba(255,255,255,0.15)]"
					aria-label="Go to homepage"
				>
					<Home size={18} aria-hidden="true" />
					Go Home
				</a>
				<BackButton client:load />
			</div>
		</div>
	</main>
</Layout>
