---
import TechIcon from '../TechIcon';
import Sheet from '../Sheet.astro';
import SectionHeader from '../SectionHeader.astro';
import siteData from '../../data/siteData.json';

const { forte, exposure } = siteData.skills;
---

<Sheet id="skills">
  <SectionHeader
    sheet="skills"
    title="Toolkit"
    lede="What I reach for every week, and what I have shipped with or keep exploring."
    meta={`${forte.length} core · ${exposure.length} more`}
  />

  <div class="tk">
    <div class="tk-group">
      <p class="mono-label tk-label">A — Daily drivers</p>
      <ul class="tk-grid">
        {forte.map((skill, i) => (
          <li class="tk-cell" data-reveal style={`--d:${i % 6}`}>
            <span class="tk-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="tk-icon" aria-hidden="true"><TechIcon name={skill.name} /></span>
            <span class="tk-name">{skill.name}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="tk-group tk-group--more">
      <p class="mono-label tk-label">B — Also shipped with</p>
      <ul class="tk-list" data-reveal>
        {exposure.map((tech) => <li>{tech}</li>)}
      </ul>
    </div>
  </div>
</Sheet>

<style>
  .tk-label {
    padding: 0.85rem var(--pad);
    border-bottom: 1px solid var(--color-border);
  }

  .tk-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    /* Cells draw their own right/bottom rules; this clips the outer edge so lines never double. */
    overflow: hidden;
  }
  .tk-cell {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.6rem;
    min-height: 8.5rem;
    margin: 0 -1px -1px 0;
    padding: 0.9rem 1rem 1rem;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    transition: background-color 0.2s, color 0.2s;
  }
  .tk-num {
    position: absolute;
    top: 0.85rem;
    right: 0.9rem;
    color: var(--color-muted);
    font: 500 10px/1 var(--font-mono);
  }
  .tk-icon {
    display: block;
    width: 1.75rem;
    height: 1.75rem;
    color: var(--color-accent);
    transition: transform 0.3s var(--ease-out);
  }
  .tk-icon > :global(div) {
    width: 100%;
    height: 100%;
  }
  .tk-icon :global(svg) {
    width: 100%;
    height: 100%;
  }
  .tk-name {
    font-size: 1.05rem;
    font-stretch: 88%;
    font-weight: 700;
    line-height: 1.1;
  }
  .tk-cell:hover {
    background: var(--color-text);
    color: var(--color-bg);
  }
  .tk-cell:hover .tk-num {
    color: inherit;
  }
  .tk-cell:hover .tk-icon {
    transform: scale(1.12) rotate(-6deg);
  }

  .tk-group--more {
    border-top: 1px solid var(--color-border);
  }
  .tk-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 0;
    padding: 1.25rem var(--pad) 1.5rem;
    list-style: none;
  }
  .tk-list li {
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--color-border);
    font: 500 12.5px/1.2 var(--font-mono);
    transition: background-color 0.15s, color 0.15s, transform 0.15s var(--ease-out);
  }
  .tk-list li:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-on-accent);
    transform: translateY(-2px);
  }

  @media (max-width: 479px) {
    .tk-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .tk-cell {
      min-height: 7rem;
    }
  }
</style>
