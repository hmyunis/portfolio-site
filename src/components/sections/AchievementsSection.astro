---
import { ArrowUpRight, ChevronLeft, ChevronRight, Maximize2, ShieldCheck, X } from 'lucide-react';
import Sheet from '../Sheet.astro';
import SectionHeader from '../SectionHeader.astro';
import ResponsiveImage from '../ResponsiveImage.astro';
import achievements from '../../data/achievements';

const CATEGORY: Record<string, string> = {
  award: 'Award',
  certification: 'Certification',
  academic: 'Academic',
  volunteering: 'Social impact',
};

const items = achievements.map((item, i) => ({
  ...item,
  number: String(i + 1).padStart(2, '0'),
  images: [item.image, ...(item.gallery ?? [])],
}));
---

<Sheet id="achievements">
  <SectionHeader
    sheet="achievements"
    title="Honors"
    lede="National awards, verified certifications, leadership programmes, and community work. Open any entry to inspect the certificate."
    meta={`${items.length} entries`}
  />

  <ol class="hn">
    {items.map((item, i) => (
      <li data-reveal style={`--d:${i % 3}`}>
        <button
          type="button"
          class="hn-row"
          data-open-dialog={`honor-${item.id}`}
          aria-haspopup="dialog"
        >
          <span class="hn-num" aria-hidden="true">{item.number}</span>
          <span class="hn-thumb media-ph" aria-hidden="true">
            <ResponsiveImage src={item.image} alt="" widths={[160, 320]} sizes="160px" width={320} height={220} />
          </span>
          <span class="hn-main">
            <span class="hn-badge">{item.badge}</span>
            <span class="hn-title">{item.title}</span>
            <span class="hn-issuer">{item.issuer}</span>
          </span>
          <span class="hn-side">
            <span class="hn-cat">{CATEGORY[item.category] ?? item.category}</span>
            <time class="hn-period">{item.period}</time>
          </span>
          <span class="hn-open" aria-hidden="true">
            <Maximize2 size={16} />
          </span>
          <span class="sr-only">, view certificate</span>
        </button>
      </li>
    ))}
  </ol>

  {items.map((item) => (
    <dialog id={`honor-${item.id}`} class="hd" aria-labelledby={`honor-${item.id}-title`} data-gallery>
      <div class="hd-box">
        <header class="hd-head">
          <div class="hd-head-text">
            <p class="mono-label">{item.number} · {item.badge}</p>
            <h3 id={`honor-${item.id}-title`} class="hd-title">{item.title}</h3>
            <p class="hd-issuer">{item.issuer} · {item.period}</p>
          </div>
          <button type="button" class="hd-icon" data-close aria-label="Close">
            <X size={18} aria-hidden="true" />
          </button>
        </header>

        <div class="hd-viewer media-ph">
          {item.images.map((image, index) => (
            <figure class="hd-figure" hidden={index > 0} data-slide={index}>
              <ResponsiveImage
                src={image}
                alt={index === 0 ? `${item.title} certificate` : `${item.title}, supporting image ${index}`}
                widths={[640, 1000, 1400]}
                sizes="(min-width: 960px) 900px, 100vw"
                class="hd-img"
              />
            </figure>
          ))}
          {item.images.length > 1 && (
            <>
              <button type="button" class="hd-icon hd-prev" data-step="-1" aria-label="Previous image">
                <ChevronLeft size={18} aria-hidden="true" />
              </button>
              <button type="button" class="hd-icon hd-next" data-step="1" aria-label="Next image">
                <ChevronRight size={18} aria-hidden="true" />
              </button>
              <p class="hd-count" aria-live="polite">
                <span data-current>1</span> / {item.images.length}
              </p>
            </>
          )}
        </div>

        <p class="hd-desc">{item.description}</p>

        {(item.credentialUrl || item.secondaryUrl) && (
          <footer class="hd-foot">
            {item.credentialUrl && (
              <a class="btn btn--sm btn--primary" href={item.credentialUrl} target="_blank" rel="noopener noreferrer">
                <ShieldCheck size={15} aria-hidden="true" />
                {item.verificationLabel || 'Verify credential'}
                <ArrowUpRight size={14} aria-hidden="true" />
              </a>
            )}
            {item.secondaryUrl && (
              <a class="btn btn--sm" href={item.secondaryUrl} target="_blank" rel="noopener noreferrer">
                {item.secondaryLabel || 'View document'}
                <ArrowUpRight size={14} aria-hidden="true" />
              </a>
            )}
          </footer>
        )}
      </div>
    </dialog>
  ))}
</Sheet>

<script>
  let opener: HTMLElement | null = null;

  document.querySelectorAll<HTMLButtonElement>('[data-open-dialog]').forEach((button) => {
    button.addEventListener('click', () => {
      const dialog = document.getElementById(button.dataset.openDialog ?? '');
      if (!(dialog instanceof HTMLDialogElement)) return;
      opener = button;
      dialog.showModal();
      document.documentElement.style.overflow = 'hidden';
    });
  });

  document.querySelectorAll<HTMLDialogElement>('[data-gallery]').forEach((dialog) => {
    const slides = [...dialog.querySelectorAll<HTMLElement>('[data-slide]')];
    const counter = dialog.querySelector('[data-current]');
    let index = 0;

    const show = (next: number) => {
      index = (next + slides.length) % slides.length;
      slides.forEach((slide, i) => (slide.hidden = i !== index));
      if (counter) counter.textContent = String(index + 1);
    };

    dialog.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((button) => {
      button.addEventListener('click', () => show(index + Number(button.dataset.step)));
    });
    dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
    // Clicking the backdrop (the dialog element itself, outside the box) closes it.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (event) => {
      if (slides.length < 2) return;
      if (event.key === 'ArrowLeft') show(index - 1);
      if (event.key === 'ArrowRight') show(index + 1);
    });
    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      show(0);
      opener?.focus();
    });
  });
</script>

<style>
  .hn {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hn li + li {
    border-top: 1px solid var(--color-border);
  }

  .hn-row {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem 9rem minmax(0, 1fr) auto 2.6rem;
    align-items: center;
    gap: 1.5rem;
    width: 100%;
    padding: 1.1rem var(--pad);
    color: inherit;
    text-align: left;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }
  .hn-row:hover {
    background: var(--color-text);
    color: var(--color-bg);
  }

  .hn-num {
    color: var(--color-accent);
    font: 500 11px/1 var(--font-mono);
  }

  .hn-thumb {
    position: relative;
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border: 1px solid var(--color-border);
  }
  .hn-thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease-out);
  }
  .hn-row:hover .hn-thumb :global(img) {
    transform: scale(1.08);
  }

  .hn-main {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }
  .hn-badge {
    width: fit-content;
    padding: 2px 6px;
    background: var(--color-accent);
    color: var(--color-on-accent);
    font: 600 10px/1.3 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .hn-title {
    font-size: clamp(1.15rem, 1.8vw, 1.6rem);
    font-stretch: 82%;
    font-weight: 800;
    line-height: 1.1;
  }
  .hn-issuer {
    color: var(--color-muted);
    font: 500 12.5px/1.4 var(--font-mono);
    transition: color 0.2s;
  }
  .hn-row:hover .hn-issuer,
  .hn-row:hover .hn-cat {
    color: inherit;
  }

  .hn-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.35rem;
    text-align: right;
  }
  .hn-cat {
    color: var(--color-muted);
    font: 500 10.5px/1.2 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .hn-period {
    font: 500 13px/1.3 var(--font-mono);
    white-space: nowrap;
  }

  .hn-open {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 2px solid currentColor;
    transition: transform 0.25s var(--ease-out), background-color 0.2s;
  }
  .hn-row:hover .hn-open {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-on-accent);
    transform: rotate(90deg);
  }

  /* ----- Dialog ----- */
  .hd {
    width: min(960px, calc(100vw - 1.5rem));
    max-width: none;
    max-height: calc(100dvh - 1.5rem);
    margin: auto;
    padding: 0;
    background: transparent;
    border: 0;
    color: var(--color-text);
    overflow: visible;
  }
  .hd::backdrop {
    background: color-mix(in srgb, var(--color-bg) 82%, transparent);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  .hd[open] .hd-box {
    animation: hd-in 0.35s var(--ease-out);
  }
  @keyframes hd-in {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.98);
    }
  }

  .hd-box {
    display: flex;
    flex-direction: column;
    max-height: calc(100dvh - 1.5rem);
    background: var(--color-bg);
    border: 2px solid var(--color-border);
    box-shadow: var(--shadow-thick);
  }

  .hd-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem var(--pad);
    border-bottom: 1px solid var(--color-border);
  }
  .hd-head-text {
    min-width: 0;
  }
  .hd-title {
    margin: 0.35rem 0 0.25rem;
    font-size: clamp(1.25rem, 2.6vw, 2rem);
    font-stretch: 80%;
    font-weight: 800;
    line-height: 1.05;
  }
  .hd-issuer {
    margin: 0;
    color: var(--color-muted);
    font: 500 12.5px/1.4 var(--font-mono);
  }

  .hd-icon {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    background: var(--color-bg);
    border: 2px solid var(--color-border);
    color: var(--color-text);
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s;
  }
  .hd-icon:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-on-accent);
  }

  .hd-viewer {
    position: relative;
    display: grid;
    flex: 1;
    min-height: 12rem;
    place-items: center;
    padding: clamp(0.75rem, 2vw, 1.25rem);
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
  }
  .hd-figure {
    display: grid;
    place-items: center;
    width: 100%;
    margin: 0;
  }
  .hd-figure[hidden] {
    display: none;
  }
  .hd-figure :global(.hd-img) {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: min(60dvh, 560px);
    object-fit: contain;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
  }
  .hd-prev,
  .hd-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
  }
  .hd-prev {
    left: 0.75rem;
  }
  .hd-next {
    right: 0.75rem;
  }
  .hd-count {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    margin: 0;
    padding: 4px 7px;
    background: var(--color-text);
    color: var(--color-bg);
    font: 500 11px/1 var(--font-mono);
  }

  .hd-desc {
    margin: 0;
    padding: 1rem var(--pad);
    color: var(--color-muted);
    font-size: 0.95rem;
  }
  .hd-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.75rem;
    padding: 0 var(--pad) 1.25rem;
  }

  @media (max-width: 899px) {
    .hn-row {
      grid-template-columns: 6.5rem minmax(0, 1fr) 2.4rem;
      gap: 0.4rem 1rem;
    }
    .hn-num {
      display: none;
    }
    .hn-thumb {
      grid-row: span 2;
      align-self: start;
    }
    .hn-side {
      grid-column: 2;
      grid-row: 2;
      flex-wrap: wrap;
      flex-direction: row;
      align-items: center;
      gap: 0.75rem;
    }
    .hn-open {
      grid-column: 3;
      grid-row: 1;
      align-self: start;
      width: 2.4rem;
      height: 2.4rem;
    }
  }
  @media (max-width: 479px) {
    .hn-row {
      grid-template-columns: 5rem minmax(0, 1fr);
    }
    .hn-open {
      display: none;
    }
  }
</style>
