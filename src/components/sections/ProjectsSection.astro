---
import { ArrowUpRight, ArrowRight, Play } from 'lucide-react';
import Sheet from '../Sheet.astro';
import SectionHeader from '../SectionHeader.astro';
import ResponsiveImage from '../ResponsiveImage.astro';
import projects from '../../data/projects';
import siteData from '../../data/siteData.json';
import { sheetNumber } from '../../config/constants';

/** Cards shown before "Show all". The rest are rendered but hidden, so their images never load until asked for. */
const INITIAL = 6;
const fig = sheetNumber('projects');
const github = siteData.socials.find((social) => social.icon === 'github');
const hiddenCount = Math.max(0, projects.length - INITIAL);
---

<Sheet id="projects">
  <SectionHeader
    sheet="projects"
    title="Selected Work"
    lede="Products I designed, built, and shipped end to end, from web platforms to native Android apps."
    meta={`${projects.length} works`}
  >
    {github && (
      <a class="pj-repos" href={github.url} target="_blank" rel="noopener noreferrer">
        All public repositories <ArrowUpRight size={14} aria-hidden="true" />
      </a>
    )}
  </SectionHeader>

  <ul class="pj-grid" data-projects>
    {projects.map((project, i) => (
      <li class="pj" hidden={i >= INITIAL} data-reveal style={`--d:${i % 3}`}>
        <a class="pj-link" href={`/projects/${project.id}`} data-demo={project.demoVideo}>
          <figure class="pj-figure media-ph">
            <ResponsiveImage
              src={project.thumbnail}
              alt=""
              widths={[400, 640, 960]}
              sizes="(min-width: 1280px) 33vw, (min-width: 720px) 50vw, 100vw"
              class="pj-img"
            />
            <figcaption class="pj-fig" aria-hidden="true">
              Fig. {fig}.{String(i + 1).padStart(2, '0')}
            </figcaption>
            {project.demoVideo && (
              <span class="pj-play" aria-hidden="true">
                <Play size={12} /> Hover to preview
              </span>
            )}
          </figure>
          <div class="pj-body">
            <div class="pj-title-row">
              <h3 class="pj-title">{project.title}</h3>
              <ArrowRight className="pj-arrow" size={20} aria-hidden="true" />
            </div>
            <p class="pj-tagline">{project.tagline}</p>
            <ul class="pj-tags" aria-label="Technologies">
              {project.tags.slice(0, 3).map((tag) => <li>{tag}</li>)}
            </ul>
          </div>
        </a>
      </li>
    ))}
  </ul>

  {hiddenCount > 0 && (
    <div class="pj-more">
      <button type="button" class="btn" data-show-all aria-controls="projects" aria-expanded="false">
        Show {hiddenCount} more works
        <span class="pj-more-count" aria-hidden="true">{INITIAL}/{projects.length}</span>
      </button>
    </div>
  )}
</Sheet>

<script>
  const grid = document.querySelector<HTMLElement>('[data-projects]');

  // "Show all": reveal the hidden cards. Their lazy images only start loading now.
  const showAll = document.querySelector<HTMLButtonElement>('[data-show-all]');
  showAll?.addEventListener('click', () => {
    const hidden = [...(grid?.querySelectorAll<HTMLElement>('.pj[hidden]') ?? [])];
    hidden.forEach((card) => {
      card.hidden = false;
      card.classList.add('is-in');
    });
    showAll.setAttribute('aria-expanded', 'true');
    showAll.parentElement?.remove();
    hidden[0]?.querySelector<HTMLAnchorElement>('a')?.focus({ preventScroll: true });
  });

  // Demo previews: the video is created on first hover, so no video bytes load on page load.
  const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
  if (grid && canHover && !reduceMotion && !saveData) {
    grid.addEventListener('pointerover', (event) => {
      const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('[data-demo]');
      if (!link || !link.dataset.demo) return;
      let video = link.querySelector('video');
      if (!video) {
        video = document.createElement('video');
        video.className = 'pj-video';
        video.muted = true;
        video.loop = true;
        video.playsInline = true;
        video.preload = 'auto';
        video.setAttribute('aria-hidden', 'true');
        video.addEventListener('playing', () => link.classList.add('is-playing'));
        video.src = link.dataset.demo;
        link.querySelector('.pj-figure')?.append(video);
      }
      video.play().catch(() => {});
    });
    grid.addEventListener('pointerout', (event) => {
      const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('[data-demo]');
      if (!link || link.contains(event.relatedTarget as Node)) return;
      link.querySelector('video')?.pause();
      link.classList.remove('is-playing');
    });
  }
</script>

<style>
  .pj-repos {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    width: fit-content;
    font: 500 12.5px/1.4 var(--font-mono);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }
  .pj-repos:hover {
    color: var(--color-accent);
  }

  .pj-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    overflow: hidden;
  }
  .pj {
    margin: 0 -1px -1px 0;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .pj[hidden] {
    display: none;
  }

  .pj-link {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .pj-figure {
    position: relative;
    aspect-ratio: 2 / 1;
    margin: 0;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
  }
  .pj-figure :global(.pj-img),
  .pj-figure :global(.pj-video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .pj-figure :global(.pj-img) {
    transition: transform 0.6s var(--ease-out), filter 0.3s;
  }
  .pj-figure :global(.pj-video) {
    opacity: 0;
    transition: opacity 0.25s;
  }
  .pj-link.is-playing .pj-figure :global(.pj-video) {
    opacity: 1;
  }
  .pj-link:hover .pj-figure :global(.pj-img) {
    transform: scale(1.04);
  }

  .pj-fig,
  .pj-play {
    position: absolute;
    z-index: 1;
    padding: 4px 7px;
    background: var(--color-text);
    color: var(--color-bg);
    font: 500 10px/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .pj-fig {
    top: 0;
    left: 0;
  }
  .pj-play {
    right: 0.6rem;
    bottom: 0.6rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: var(--color-accent);
    color: var(--color-on-accent);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.2s, transform 0.2s var(--ease-out);
  }
  .pj-link:hover .pj-play {
    opacity: 1;
    transform: none;
  }
  .pj-link.is-playing .pj-play {
    opacity: 0;
  }

  .pj-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.1rem var(--pad) 1.3rem;
  }
  .pj-title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }
  .pj-title {
    margin: 0;
    font-size: clamp(1.35rem, 1.9vw, 1.7rem);
    font-stretch: 78%;
    font-weight: 800;
    line-height: 1.05;
    text-transform: uppercase;
    transition: color 0.15s;
  }
  .pj-link :global(.pj-arrow) {
    flex-shrink: 0;
    margin-top: 0.15rem;
    color: var(--color-muted);
    transition: transform 0.25s var(--ease-out), color 0.15s;
  }
  .pj-link:hover .pj-title,
  .pj-link:hover :global(.pj-arrow) {
    color: var(--color-accent);
  }
  .pj-link:hover :global(.pj-arrow) {
    transform: translateX(4px);
  }

  .pj-tagline {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: var(--color-muted);
    font-size: 0.93rem;
    line-height: 1.5;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  .pj-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: auto 0 0;
    padding: 0.5rem 0 0;
    list-style: none;
  }
  .pj-tags li {
    padding: 3px 7px;
    border: 1px solid var(--hair);
    color: var(--color-muted);
    font: 500 11px/1.3 var(--font-mono);
  }

  .pj-more {
    display: flex;
    justify-content: center;
    padding: 1.75rem var(--pad) 2rem;
  }
  .pj-more-count {
    padding-left: 0.6rem;
    border-left: 1px solid currentColor;
    color: var(--color-muted);
    font: 500 11px/1 var(--font-mono);
  }

  @media (max-width: 1279px) {
    .pj-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 719px) {
    .pj-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
