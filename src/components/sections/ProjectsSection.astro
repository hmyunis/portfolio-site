---
import ProjectCard from '../ui/ProjectCard';
import SkeletonCard from '../ui/SkeletonCard';
import { ArrowRight } from 'lucide-react';
import projects from '../../data/projects.json';
---

<section class="py-20 border-t border-border" id="projects">
	<div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4 mb-12">
		<div>
			<h2 class="text-3xl font-bold mb-2">Selected Works</h2>
			<p class="text-muted">Projects I've built and shipped</p>
		</div>
		<a
			href="https://github.com/hmyunis"
			target="_blank"
			rel="noopener noreferrer"
			class="flex items-center gap-2 text-muted hover:text-accent transition-all hover:gap-3"
			aria-label="View all repositories on GitHub"
		>
			View all repositories <ArrowRight size={16} aria-hidden="true" />
		</a>
	</div>

	<div class="grid md:grid-cols-2 gap-8" role="list">
		{projects.map((project) => (
			<ProjectCard
				client:idle
				id={project.id}
				title={project.title}
				tagline={project.tagline}
				images={project.images}
				tags={project.tags}
			/>
		))}
	</div>
</section>
